# Site-specific settings for the roomlog user units. Copy to ~/.config/roomlog/service.env.
# Ingest binds loopback only; tailscale serve publishes it over HTTPS on the tailnet name
# (ADR 0007). Run once, as a user in the tailscale operator group or with sudo:
#   tailscale serve --bg --https=443 http://127.0.0.1:8480
# Clients then use https://oma.tailf63b9a.ts.net. No ufw rule is needed: nothing listens
# on the tailnet interface.
ROOMLOG_BIND=127.0.0.1:8480
