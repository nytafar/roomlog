# Publishes roomlog-reader (127.0.0.1:8540) on the tailnet as its own node, `roomlog`, at
# https://roomlog.tailf63b9a.ts.net, and passes the visitor's Tailscale login to the reader in
# Tailscale-User-Login so the owner gets in without a token (ADR 0009). The proxy deletes any
# client-supplied identity headers and sets none for tagged nodes; the reader honours the
# header only for `tailscale_logins` in reader.toml, and only on a loopback bind.
#
# Install (systemd --user on oma; nothing in install.sh does this):
#   1. Build the pinned proxy (tailscale.com needs go >= 1.27.1; GOTOOLCHAIN=auto fetches it):
#        GOBIN=$HOME/.local/bin go install tailscale.com/cmd/tsnet-proxy@v1.104.1
#   2. Create a pre-auth key tagged tag:svc in the admin console (reusable: no; ephemeral: no),
#      and store it outside the repo, readable only by you:
#        install -d -m 700 ~/.config/roomlog-tsnet
#        (umask 077; printf 'TS_AUTHKEY=%s\n' 'tskey-auth-...' > ~/.config/roomlog-tsnet/authkey.env)
#      The key is only needed for the first join; node state then lives in the --dir below,
#      and the file may be deleted (the `-` makes it optional).
#   3. cp deploy/server/roomlog-tsnet-proxy.service ~/.config/systemd/user/
#      systemctl --user daemon-reload && systemctl --user enable --now roomlog-tsnet-proxy
#   4. Add the owner's login to reader.toml (`tailscale_logins = ["nytafar@github"]`) and
#      restart roomlog-reader.
[Unit]
Description=Room Log recall on the tailnet (tsnet-proxy roomlog -> roomlog-reader)
After=network-online.target roomlog-reader.service
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=-%h/.config/roomlog-tsnet/authkey.env
ExecStartPre=/usr/bin/mkdir -p -m 700 %h/.local/share/roomlog-tsnet
ExecStart=%h/.local/bin/tsnet-proxy --https --dir %h/.local/share/roomlog-tsnet roomlog 8540 443
Restart=on-failure
RestartSec=5
MemoryMax=256M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=true
UMask=0077
[Install]
WantedBy=default.target
